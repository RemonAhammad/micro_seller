# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — `.env.example` is the tracked template.

# Google OAuth Client IDs (one per Android signing variant + iOS/web)
GOOGLE_OAUTH_ANDROID_DEBUG_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_UPLOAD_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_PLAY_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Security feature visibility (build-time). Controls whether each toggle is
# shown in Settings → Security. The user still controls whether the toggle is
# ON or OFF — these flags only decide if the toggle row is rendered at all.
# Both default to true if missing/blank. Set to "false" to hide a toggle.
ENABLE_FINGERPRINT_GATE=true
ENABLE_PIN_GATE=true
